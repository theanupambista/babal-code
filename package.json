{
  "name": "babal-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch run apps/cli/src/index.tsx",
    "start": "bun run apps/cli/src/index.tsx",
    "typecheck": "bun run --filter '*' typecheck",
    "release:build": "bun run scripts/release/build.ts",
    "release:prepare": "bun run scripts/release/prepare.ts",
    "release:pack": "bun run scripts/release/pack.ts",
    "release:publish": "bun run scripts/release/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@vscode/ripgrep"
  ]
}
