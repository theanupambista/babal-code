{
  "name": "babal-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch run apps/cli/src/index.tsx",
    "start": "bun run apps/cli/src/index.tsx",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@vscode/ripgrep"
  ]
}
