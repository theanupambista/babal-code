{
  "name": "babal-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "cli"
  ],
  "scripts": {
    "dev:server": "bun run --filter @babalcode/server dev",
    "dev:cli": "bun run --cwd cli dev",
    "start:server": "bun run --filter @babalcode/server start",
    "start:cli": "bun run --cwd cli start",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
