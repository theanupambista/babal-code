datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model Session {
  id        String   @id @default(cuid())
  title     String? // optional human/derived label
  model     String? // e.g. "gemini-2.5-flash"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Entry[]
}

// One ordered timeline of everything that happened in a session: user/assistant
// messages (with their tool calls and reasoning) and errors, interleaved in the
// order they occurred.
model Entry {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  seq  Int // monotonic position within the session
  type String // discriminator: "message" | "error"

  // type = "message"
  messageId String? // originating UIMessage id — lets writes be idempotent
  role      String? // "system" | "user" | "assistant" (SQLite has no enums)
  parts     Json? // the UIMessage parts[] — text, reasoning, tool calls, states

  // type = "error"
  errorText String? // useChat error message
  stack     String? // optional detail

  createdAt DateTime @default(now())

  @@unique([sessionId, seq]) // no two entries share a position
  @@unique([sessionId, messageId]) // upsert target; multiple NULLs allowed (errors)
  @@index([sessionId, seq]) // ordered replay
}
